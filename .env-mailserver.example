# Mailserver config
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=0
ENABLE_POSTGREY=0
ONE_DIR=1
DMS_DEBUG=0
PERMIT_DOCKER=network

# Enable quotas
ENABLE_QUOTAS=1

# Enable rspamd (spam filtering + rate limiting)
# rspamd replaces SpamAssassin and adds rate limiting capabilities
# Rate limits are configured via: easy-mailstack --set-rate-limit --limit <N>
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_CHECK_AUTHENTICATED=1
RSPAMD_GREYLISTING=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
# Helper script default; rendered Rspamd config lives in config/rspamd/override.d/ratelimit.conf
MAIL_RATE_LIMIT_PER_DAY=1000

# Essential additions for proper functionality
OVERRIDE_HOSTNAME=mail.domain.com
POSTMASTER_ADDRESS=postmaster@domain.com

# SSL/TLS Configuration - using empty/none for initial setup
SSL_TYPE=

# IMAP/POP3 settings
ENABLE_POP3=0
ENABLE_IMAP=1

# Security settings
TLS_LEVEL=modern
SPOOF_PROTECTION=1
ENABLE_SRS=1

# Logging
LOG_LEVEL=info

# Dovecot settings for better compatibility with Roundcube
DOVECOT_MAILBOX_FORMAT=maildir
DOVECOT_TLS=yes

# PostFix settings
POSTFIX_REJECT_UNKNOWN_CLIENT_HOSTNAME=0
POSTFIX_INET_PROTOCOLS=ipv4
