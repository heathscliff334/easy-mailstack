# Mailserver config
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=0
ENABLE_POSTGREY=0
ONE_DIR=1
DMS_DEBUG=0
PERMIT_DOCKER=network

# Essential additions for proper functionality
OVERRIDE_HOSTNAME=mail.domain.com
POSTMASTER_ADDRESS=postmaster@domain.com

# SSL/TLS Configuration - using empty/none for initial setup
SSL_TYPE=

# IMAP/POP3 settings
ENABLE_POP3=0
ENABLE_IMAP=1

# Security settings
TLS_LEVEL=modern
SPOOF_PROTECTION=1
ENABLE_SRS=1

# Logging
LOG_LEVEL=info

# Dovecot settings for better compatibility with Roundcube
DOVECOT_MAILBOX_FORMAT=maildir
DOVECOT_TLS=yes

# PostFix settings
POSTFIX_REJECT_UNKNOWN_CLIENT_HOSTNAME=0
POSTFIX_INET_PROTOCOLS=ipv4
